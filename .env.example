# .env.example
# Modelo das variáveis que o docker compose lê.
# Objetivo: documentar o que existe. Não copie à mão: `make env` cria o .env (ignorado pelo
# git) com um JWT_SECRET aleatório. O segredo assina os tokens de acesso e precisa ter pelo
# menos 32 bytes; trocá-lo invalida todos os tokens emitidos.

JWT_SECRET=gerado-por-make-env
